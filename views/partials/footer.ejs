</main>

<script>
(function () {
    var thisUrlBase = <%- JSON.stringify(typeof thisUrl !== 'undefined' ? thisUrl : '') %>;

    function toAbsoluteApiCall(text) {
        var t = String(text || '').trim();
        if (!t) return t;
        if (/^https?:\/\//i.test(t)) return t;
        if (t.charAt(0) === '/' && thisUrlBase) {
            return String(thisUrlBase).replace(/\/+$/, '') + t;
        }
        return t;
    }

    function copyToClipboard(text) {
        if (navigator.clipboard && navigator.clipboard.writeText) {
            return navigator.clipboard.writeText(text);
        }
        return new Promise(function (resolve, reject) {
            try {
                var input = document.createElement('input');
                input.type = 'text';
                input.value = text;
                document.body.appendChild(input);
                input.select();
                document.execCommand('copy');
                document.body.removeChild(input);
                resolve();
            } catch (e) {
                reject(e);
            }
        });
    }

    function initCopyIdButtons() {
        var buttons = document.querySelectorAll('.copy-id-btn[data-copy-text], .copy-id-btn[data-copy-id]');
        if (!buttons.length) return;
        buttons.forEach(function (btn) {
            if (btn._copyIdBound) return;
            btn._copyIdBound = true;
            btn.addEventListener('click', function (e) {
                e.preventDefault();
                e.stopPropagation();
                var rawText = btn.getAttribute('data-copy-text') || btn.getAttribute('data-copy-id');
                var text = toAbsoluteApiCall(rawText);
                if (!text) return;
                var originalTitle = btn.getAttribute('title') || 'Copy API call to clipboard';
                copyToClipboard(text)
                    .then(function () {
                        btn.setAttribute('title', 'Copied!');
                        btn.classList.add('copied');
                        setTimeout(function () {
                            btn.setAttribute('title', originalTitle);
                            btn.classList.remove('copied');
                        }, 1500);
                    })
                    .catch(function () {
                        alert('Unable to copy API call to clipboard');
                    });
            });
        });
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initCopyIdButtons);
    } else {
        initCopyIdButtons();
    }
})();

(function () {
    function initAiCoachButtons() {
        var buttons = document.querySelectorAll('a.ai-coach-btn');
        if (!buttons.length) return;
        buttons.forEach(function (btn) {
            if (btn._aiCoachBound) return;
            btn._aiCoachBound = true;
            btn.addEventListener('click', function (e) {
                if (btn._aiCoachClicked) {
                    e.preventDefault();
                    e.stopPropagation();
                    return false;
                }
                btn._aiCoachClicked = true;
                btn.classList.add('disabled');
                btn.setAttribute('aria-disabled', 'true');
                btn.style.pointerEvents = 'none';
                btn.textContent = 'Generating...';
            });
        });
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initAiCoachButtons);
    } else {
        initAiCoachButtons();
    }
})();

(function () {
    function initConfirmForms() {
        var forms = document.querySelectorAll('form[data-confirm]');
        if (!forms.length) return;
        forms.forEach(function (form) {
            if (form._confirmBound) return;
            form._confirmBound = true;
            form.addEventListener('submit', function (e) {
                var msg = form.getAttribute('data-confirm') || 'Are you sure?';
                if (!window.confirm(msg)) {
                    e.preventDefault();
                    e.returnValue = false;
                    return false;
                }
            });
        });
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initConfirmForms);
    } else {
        initConfirmForms();
    }
})();

(function () {
    function initFormbarPollButtons() {
        var buttons = document.querySelectorAll('.formbar-poll-btn[data-poll-url]');
        if (!buttons.length) return;
        buttons.forEach(function (btn) {
            if (btn._formbarPollBound) return;
            btn._formbarPollBound = true;
            btn.addEventListener('click', function (e) {
                e.preventDefault();
                e.stopPropagation();
                if (btn.disabled) return;
                var url = btn.getAttribute('data-poll-url');
                if (!url) return;
                var originalTitle = btn.getAttribute('title') || 'Create Formbar poll';
                var originalLabel = btn.getAttribute('aria-label') || originalTitle;
                btn.disabled = true;
                btn.classList.add('busy');
                btn.setAttribute('title', 'Creating poll...');
                fetch(url, {
                    method: 'POST',
                    headers: {
                        'Accept': 'application/json',
                        'Content-Type': 'application/json'
                    },
                    credentials: 'same-origin',
                    body: '{}'
                })
                    .then(function (res) {
                        return res.json().catch(function () { return {}; }).then(function (data) {
                            return { ok: res.ok, status: res.status, data: data };
                        });
                    })
                    .then(function (result) {
                        if (!result.ok || !result.data || result.data.ok === false) {
                            var msg = (result.data && (result.data.error || result.data.message))
                                || ('Failed to create Formbar poll (' + result.status + ')');
                            throw new Error(msg);
                        }
                        var classLabel = result.data.className
                            ? (' in ' + result.data.className)
                            : '';
                        btn.setAttribute('title', 'Poll created' + classLabel);
                        btn.classList.add('copied');
                        setTimeout(function () {
                            btn.setAttribute('title', originalTitle);
                            btn.setAttribute('aria-label', originalLabel);
                            btn.classList.remove('copied');
                        }, 2000);
                    })
                    .catch(function (err) {
                        alert(err.message || 'Failed to create Formbar poll');
                        btn.setAttribute('title', originalTitle);
                    })
                    .finally(function () {
                        btn.disabled = false;
                        btn.classList.remove('busy');
                    });
            });
        });
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initFormbarPollButtons);
    } else {
        initFormbarPollButtons();
    }
})();

</script>

</body>
</html>
