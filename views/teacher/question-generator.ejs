<%- include('../partials/teacher-header', { title: 'Question Generator - ' + course.name, user, course,
    breadcrumb: '<a href="/courses/' + course.id + '">' + course.name + '</a> &rarr; Question generator' }) %>

<p><a href="/courses#course-<%= course.id %>" class="btn btn-secondary">Back to courses</a></p>

<div id="question-generator-root" data-course-id="<%= course.id %>">

    <section style="margin-top: 1rem; margin-bottom: 1.5rem;">
        <h1>Question search</h1>
        <p>Find existing questions in this course by text in the prompt.</p>
        <div class="field-row" style="max-width: 36rem;">
            <input type="text" id="question-search-input" placeholder="Search question prompts..."
                style="flex:1; padding:0.5rem; border:1px solid #ccc; border-radius:4px;">
            <button type="button" id="question-search-btn" class="btn" style="margin-left:0.5rem;">Search</button>
        </div>
        <div id="question-search-results" class="text-muted" style="margin-top: 1rem;"></div>
    </section>

    <h1>Question Generator</h1>

    <div class="generator-controls">
        <label>Unit
            <select id="unit-select">
                <option value="">Select unit</option>
                <option value="all">All units</option>
                <% units.forEach(function(u) { %>
                    <option value="<%= u.id %>">
                        <%= u.name %>
                    </option>
                    <% }); %>
            </select>
        </label>
        <div id="task-list-container" style="margin-top: 0.75rem;">
            <label>Task</label>
            <div id="task-list"></div>
            <div id="task-details"
                style="display: none; margin-top: 0.75rem; padding: 0.75rem; background: #f5f5f5; border-radius: 4px; border: 1px solid #eee;">
                <p style="margin: 0 0 0.35rem 0;"><strong>Learning target:</strong> <span id="task-details-target"
                        class="text-muted"></span></p>
                <p style="margin: 0 0 0.35rem 0;"><strong>Description:</strong> <span id="task-details-description"
                        class="text-muted"></span></p>
                <p style="margin: 0;"><strong>Good questions in this task:</strong> <span
                        id="task-details-good-count">0</span></p>
            </div>
        </div>
        <div style="margin-top: 1rem; max-width: 36rem;">
            <label for="additional-context">Additional prompt context (optional)</label>
            <textarea id="additional-context" rows="3"
                placeholder="e.g. Focus on safety procedures only, avoid trick questions, use 9th-grade vocabulary…"
                style="width: 100%; display: block; margin-top: 0.35rem; padding: 0.5rem; border: 1px solid #ccc; border-radius: 4px; font-family: inherit;"></textarea>
            <div style="margin-top: 0.5rem; display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center;">
                <button type="button" id="improve-prompt-btn" class="btn btn-secondary btn-small">Improve prompt</button>
                <button type="button" id="save-prompt-btn" class="btn btn-secondary btn-small">Save</button>
                <label class="btn btn-secondary btn-small" style="cursor: pointer; margin: 0;">
                    Add file
                    <input type="file" id="prompt-file-input" accept=".txt,.md,.csv,.pdf,.docx,text/plain"
                        style="display: none;">
                </label>
            </div>
            <div id="prompt-files-list" style="margin-top: 0.5rem;"></div>
            <p id="prompt-budget" class="text-muted" style="margin-top: 0.35rem; font-size: 0.9rem;"></p>
            <div style="margin-top: 0.75rem;">
                <label for="saved-prompts-select">Saved prompts</label>
                <div style="display: flex; gap: 0.5rem; margin-top: 0.35rem;">
                    <select id="saved-prompts-select" style="flex: 1; padding: 0.4rem; border: 1px solid #ccc; border-radius: 4px;">
                        <option value="">— Select a saved prompt —</option>
                    </select>
                    <button type="button" id="load-prompt-btn" class="btn btn-secondary btn-small">Load</button>
                </div>
            </div>
            <p id="prompt-context-status" class="text-muted" style="margin-top: 0.35rem; display: none;"></p>
        </div>
        <p style="margin-top: 1rem;">
            <button type="button" id="generate-btn" class="btn" disabled>Generate <%= generatorRoundCount || 10 %> questions</button>
        </p>
    </div>

    <div id="generator-loading" class="text-muted" style="display: none;">Generating...</div>
    <div id="generator-error" class="text-muted" style="display: none; color: #c00;"></div>
    <div id="questions-container" style="margin-top: 1.5rem;"></div>

    <script>
        (function () {
            var rootEl = document.getElementById('question-generator-root');
            var courseId = rootEl ? parseInt(rootEl.getAttribute('data-course-id'), 10) : null;
            var promptLimits = {
                maxFileBytes: <%= (promptLimits && promptLimits.maxFileBytes) || 52428800 %>,
                maxTotalBytes: <%= (promptLimits && promptLimits.maxTotalBytes) || 52428800 %>,
                maxWords: <%= (promptLimits && promptLimits.maxWords) || 10000 %>,
                maxFiles: <%= (promptLimits && promptLimits.maxFiles) || 5 %>
            };
            var selectedTaskId = null;
            var tasksCache = [];
            var attachedFiles = [];

            var unitSelect = document.getElementById('unit-select');
            var taskList = document.getElementById('task-list');
            var taskDetailsEl = document.getElementById('task-details');
            var taskDetailsTarget = document.getElementById('task-details-target');
            var taskDetailsDescription = document.getElementById('task-details-description');
            var taskDetailsGoodCount = document.getElementById('task-details-good-count');
            var additionalContextEl = document.getElementById('additional-context');
            var generateBtn = document.getElementById('generate-btn');
            var loadingEl = document.getElementById('generator-loading');
            var errorEl = document.getElementById('generator-error');
            var questionsContainer = document.getElementById('questions-container');
            var improvePromptBtn = document.getElementById('improve-prompt-btn');
            var savePromptBtn = document.getElementById('save-prompt-btn');
            var promptFileInput = document.getElementById('prompt-file-input');
            var promptFilesList = document.getElementById('prompt-files-list');
            var promptBudgetEl = document.getElementById('prompt-budget');
            var savedPromptsSelect = document.getElementById('saved-prompts-select');
            var loadPromptBtn = document.getElementById('load-prompt-btn');
            var promptContextStatus = document.getElementById('prompt-context-status');

            var searchInput = document.getElementById('question-search-input');
            var searchBtn = document.getElementById('question-search-btn');
            var searchResultsEl = document.getElementById('question-search-results');

            function showError(msg) {
                errorEl.textContent = msg || '';
                errorEl.style.display = msg ? 'block' : 'none';
            }

            function showPromptStatus(msg, isError) {
                if (!promptContextStatus) return;
                if (!msg) {
                    promptContextStatus.style.display = 'none';
                    promptContextStatus.textContent = '';
                    return;
                }
                promptContextStatus.style.display = 'block';
                promptContextStatus.style.color = isError ? '#c00' : '';
                promptContextStatus.textContent = msg;
            }

            function countWords(text) {
                var s = String(text || '').trim();
                if (!s) return 0;
                return s.split(/\s+/).filter(Boolean).length;
            }

            function formatBytes(n) {
                if (n < 1024) return n + ' B';
                if (n < 1024 * 1024) return (n / 1024).toFixed(1) + ' KB';
                return (n / (1024 * 1024)).toFixed(1) + ' MB';
            }

            function updateBudget() {
                if (!promptBudgetEl) return;
                var textWords = countWords(additionalContextEl && additionalContextEl.value);
                var fileWords = 0;
                var fileBytes = 0;
                attachedFiles.forEach(function (f) {
                    fileWords += f.wordCount || 0;
                    fileBytes += f.byteSize || 0;
                });
                promptBudgetEl.textContent =
                    'Words: ' + (textWords + fileWords) + ' / ' + promptLimits.maxWords +
                    ' · Files: ' + attachedFiles.length + ' / ' + promptLimits.maxFiles +
                    ' · Size: ' + formatBytes(fileBytes) + ' / ' + formatBytes(promptLimits.maxTotalBytes);
            }

            function renderAttachedFiles() {
                if (!promptFilesList) return;
                if (!attachedFiles.length) {
                    promptFilesList.innerHTML = '';
                    updateBudget();
                    return;
                }
                var html = '<ul style="margin:0; padding-left:1.2rem;">';
                attachedFiles.forEach(function (f, idx) {
                    html += '<li style="margin-bottom:0.25rem;">' +
                        escapeHtml(f.originalName || 'file') +
                        ' <span class="text-muted">(' + (f.wordCount || 0) + ' words, ' + formatBytes(f.byteSize || 0) + ')</span> ' +
                        '<button type="button" class="btn btn-small btn-danger" data-remove-file="' + idx + '">Remove</button></li>';
                });
                html += '</ul>';
                promptFilesList.innerHTML = html;
                var buttons = promptFilesList.querySelectorAll('[data-remove-file]');
                for (var i = 0; i < buttons.length; i++) {
                    buttons[i].addEventListener('click', function () {
                        var idx = parseInt(this.getAttribute('data-remove-file'), 10);
                        if (!isNaN(idx)) {
                            attachedFiles.splice(idx, 1);
                            renderAttachedFiles();
                        }
                    });
                }
                updateBudget();
            }

            function currentFilesPayload() {
                return attachedFiles.map(function (f) {
                    return {
                        contentHash: f.contentHash,
                        originalName: f.originalName,
                        storedName: f.storedName,
                        mimeType: f.mimeType,
                        byteSize: f.byteSize,
                        wordCount: f.wordCount
                    };
                });
            }

            function refreshSavedPrompts() {
                if (!savedPromptsSelect) return;
                fetch('/courses/' + courseId + '/prompts', { credentials: 'same-origin' })
                    .then(function (r) { return r.json(); })
                    .then(function (list) {
                        var current = savedPromptsSelect.value;
                        savedPromptsSelect.innerHTML = '<option value="">— Select a saved prompt —</option>';
                        if (!Array.isArray(list)) return;
                        list.forEach(function (p) {
                            var opt = document.createElement('option');
                            opt.value = p.id;
                            var label = p.promptPreview || '(files only)';
                            if (p.fileNames && p.fileNames.length) {
                                label += ' [' + p.fileNames.length + ' file' + (p.fileNames.length === 1 ? '' : 's') + ']';
                            }
                            opt.textContent = label;
                            savedPromptsSelect.appendChild(opt);
                        });
                        if (current) savedPromptsSelect.value = current;
                    })
                    .catch(function () { /* ignore */ });
            }

            function showTaskDetails(task) {
                if (!task) {
                    taskDetailsEl.style.display = 'none';
                    return;
                }
                taskDetailsTarget.textContent = (task.target && task.target.trim()) ? task.target : '—';
                taskDetailsDescription.textContent = (task.description && task.description.trim()) ? task.description : '—';
                taskDetailsGoodCount.textContent = task.good_count != null ? task.good_count : 0;
                taskDetailsEl.style.display = 'block';
            }

            function escapeHtml(s) {
                if (s == null) return '';
                var div = document.createElement('div');
                div.textContent = s;
                return div.innerHTML;
            }

            function renderSearchResults(list) {
                if (!Array.isArray(list) || !list.length) {
                    searchResultsEl.innerHTML = '<p class="text-muted">No matching questions found.</p>';
                    return;
                }
                var html = '<table><thead><tr><th>Prompt</th><th>Task</th><th></th></tr></thead><tbody>';
                list.forEach(function (row) {
                    var prompt = (row.prompt || '').slice(0, 120);
                    if ((row.prompt || '').length > 120) prompt += '…';
                    var taskName = row.task_name || ('Task ' + row.task_id);
                    var editHref = '/courses/' + courseId + '/tasks/' + row.task_id + '/questions/' + row.id;
                    html += '<tr>' +
                        '<td>' + escapeHtml(prompt) + '</td>' +
                        '<td>' + escapeHtml(taskName) + '</td>' +
                        '<td><a class="btn btn-small" href="' + editHref + '">Edit</a></td>' +
                        '</tr>';
                });
                html += '</tbody></table>';
                searchResultsEl.innerHTML = html;
            }

            function doSearch() {
                if (!searchInput || !searchResultsEl) return;
                var q = (searchInput.value || '').trim();
                if (!q) {
                    searchResultsEl.innerHTML = '<p class="text-muted">Enter text to search question prompts.</p>';
                    return;
                }
                searchResultsEl.innerHTML = '<p class="text-muted">Searching…</p>';
                fetch('/courses/' + courseId + '/questions/search?q=' + encodeURIComponent(q), {
                    credentials: 'same-origin'
                })
                    .then(function (r) { return r.json(); })
                    .then(function (list) { renderSearchResults(list); })
                    .catch(function () {
                        searchResultsEl.innerHTML = '<p class="text-muted" style="color:#c00;">Search failed.</p>';
                    });
            }

            if (searchBtn && searchInput) {
                searchBtn.addEventListener('click', doSearch);
                searchInput.addEventListener('keydown', function (ev) {
                    if (ev.key === 'Enter') {
                        ev.preventDefault();
                        doSearch();
                    }
                });
            }

            if (additionalContextEl) {
                additionalContextEl.addEventListener('input', updateBudget);
            }

            if (promptFileInput) {
                promptFileInput.addEventListener('change', function () {
                    var file = promptFileInput.files && promptFileInput.files[0];
                    promptFileInput.value = '';
                    if (!file) return;
                    if (attachedFiles.length >= promptLimits.maxFiles) {
                        showPromptStatus('Maximum of ' + promptLimits.maxFiles + ' files allowed.', true);
                        return;
                    }
                    if (file.size > promptLimits.maxFileBytes) {
                        showPromptStatus(
                            'This file is ' + formatBytes(file.size) +
                            ', which exceeds the ' + formatBytes(promptLimits.maxFileBytes) + ' per-file limit.',
                            true
                        );
                        return;
                    }
                    var usedBytes = 0;
                    attachedFiles.forEach(function (f) { usedBytes += f.byteSize || 0; });
                    if (usedBytes + file.size > promptLimits.maxTotalBytes) {
                        showPromptStatus(
                            'Adding this file would exceed the ' + formatBytes(promptLimits.maxTotalBytes) + ' total size limit.',
                            true
                        );
                        return;
                    }
                    showPromptStatus('Uploading ' + file.name + '…');
                    var formData = new FormData();
                    formData.append('file', file);
                    fetch('/courses/' + courseId + '/prompts/upload', {
                        method: 'POST',
                        body: formData,
                        credentials: 'same-origin'
                    })
                        .then(function (r) {
                            return r.json().then(function (body) {
                                if (!r.ok) throw new Error(body.error || 'Upload failed');
                                return body;
                            });
                        })
                        .then(function (meta) {
                            var exists = attachedFiles.some(function (f) { return f.contentHash === meta.contentHash; });
                            if (!exists) attachedFiles.push(meta);
                            renderAttachedFiles();
                            showPromptStatus('Added ' + (meta.originalName || 'file') + '.');
                        })
                        .catch(function (err) {
                            showPromptStatus(err.message || 'Upload failed.', true);
                        });
                });
            }

            if (savePromptBtn) {
                savePromptBtn.addEventListener('click', function () {
                    var promptText = (additionalContextEl && additionalContextEl.value) ? additionalContextEl.value.trim() : '';
                    if (!promptText && !attachedFiles.length) {
                        showPromptStatus('Add text or files before saving.', true);
                        return;
                    }
                    savePromptBtn.disabled = true;
                    fetch('/courses/' + courseId + '/prompts/save', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ promptText: promptText, files: currentFilesPayload() }),
                        credentials: 'same-origin'
                    })
                        .then(function (r) {
                            return r.json().then(function (body) {
                                if (!r.ok) throw new Error(body.error || 'Save failed');
                                return body;
                            });
                        })
                        .then(function () {
                            showPromptStatus('Prompt saved for reuse.');
                            refreshSavedPrompts();
                        })
                        .catch(function (err) {
                            showPromptStatus(err.message || 'Save failed.', true);
                        })
                        .finally(function () { savePromptBtn.disabled = false; });
                });
            }

            if (improvePromptBtn) {
                improvePromptBtn.addEventListener('click', function () {
                    var promptText = (additionalContextEl && additionalContextEl.value) ? additionalContextEl.value.trim() : '';
                    if (!promptText) {
                        showPromptStatus('Enter prompt text to improve.', true);
                        return;
                    }
                    improvePromptBtn.disabled = true;
                    showPromptStatus('Improving prompt…');
                    fetch('/courses/' + courseId + '/prompts/improve', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ promptText: promptText, hasFiles: attachedFiles.length > 0 }),
                        credentials: 'same-origin'
                    })
                        .then(function (r) {
                            return r.json().then(function (body) {
                                if (!r.ok) throw new Error(body.error || 'Improve failed');
                                return body;
                            });
                        })
                        .then(function (body) {
                            if (additionalContextEl && body.promptText) {
                                additionalContextEl.value = body.promptText;
                                updateBudget();
                            }
                            showPromptStatus('Prompt improved. Review and edit if needed.');
                        })
                        .catch(function (err) {
                            showPromptStatus(err.message || 'Improve failed.', true);
                        })
                        .finally(function () { improvePromptBtn.disabled = false; });
                });
            }

            if (loadPromptBtn && savedPromptsSelect) {
                loadPromptBtn.addEventListener('click', function () {
                    var id = savedPromptsSelect.value;
                    if (!id) {
                        showPromptStatus('Select a saved prompt first.', true);
                        return;
                    }
                    loadPromptBtn.disabled = true;
                    fetch('/courses/' + courseId + '/prompts/' + encodeURIComponent(id), {
                        credentials: 'same-origin'
                    })
                        .then(function (r) {
                            return r.json().then(function (body) {
                                if (!r.ok) throw new Error(body.error || 'Load failed');
                                return body;
                            });
                        })
                        .then(function (body) {
                            if (additionalContextEl) additionalContextEl.value = body.promptText || '';
                            attachedFiles = Array.isArray(body.files) ? body.files.slice() : [];
                            renderAttachedFiles();
                            showPromptStatus('Loaded saved prompt.');
                        })
                        .catch(function (err) {
                            showPromptStatus(err.message || 'Load failed.', true);
                        })
                        .finally(function () { loadPromptBtn.disabled = false; });
                });
            }

            refreshSavedPrompts();
            updateBudget();

            unitSelect.addEventListener('change', function () {
                var unitId = unitSelect.value;
                selectedTaskId = null;
                tasksCache = [];
                taskDetailsEl.style.display = 'none';
                generateBtn.disabled = true;
                questionsContainer.innerHTML = '';
                showError('');
                if (!unitId) {
                    taskList.innerHTML = '';
                    return;
                }
                fetch('/courses/' + courseId + '/generator/tasks?unitId=' + encodeURIComponent(unitId))
                    .then(function (r) { return r.json(); })
                    .then(function (tasks) {
                        tasksCache = tasks || [];
                        taskList.innerHTML = '';
                        if (tasks.length === 0) {
                            taskList.innerHTML = '<p class="text-muted">No tasks in this selection.</p>';
                            return;
                        }
                        tasks.forEach(function (t) {
                            var label = document.createElement('label');
                            label.style.display = 'block';
                            label.style.marginBottom = '0.35rem';
                            var radio = document.createElement('input');
                            radio.type = 'radio';
                            radio.name = 'task';
                            radio.value = t.id;
                            radio.addEventListener('change', function () {
                                selectedTaskId = parseInt(radio.value, 10);
                                generateBtn.disabled = false;
                                var selected = tasksCache.filter(function (x) { return x.id === selectedTaskId; })[0];
                                showTaskDetails(selected);
                            });
                            label.appendChild(radio);
                            label.appendChild(document.createTextNode(' ' + (t.name || 'Task ' + t.id)));
                            taskList.appendChild(label);
                        });
                    })
                    .catch(function () {
                        showError('Failed to load tasks.');
                        taskList.innerHTML = '';
                    });
            });

            generateBtn.addEventListener('click', function () {
                if (!selectedTaskId) return;
                loadingEl.style.display = 'block';
                errorEl.style.display = 'none';
                questionsContainer.innerHTML = '';
                var promptText = (additionalContextEl && additionalContextEl.value) ? additionalContextEl.value.trim() : '';
                fetch('/courses/' + courseId + '/questions/generate', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        taskId: selectedTaskId,
                        promptText: promptText || undefined,
                        files: currentFilesPayload()
                    }),
                    credentials: 'same-origin'
                })
                    .then(function (r) {
                        loadingEl.style.display = 'none';
                        if (!r.ok) return r.json().then(function (e) { throw new Error(e.error || 'Generate failed'); });
                        return r.json();
                    })
                    .then(function (questions) {
                        if (!Array.isArray(questions) || questions.length === 0) {
                            showError('No questions returned.');
                            return;
                        }
                        questions.forEach(function (q, idx) {
                            var card = document.createElement('div');
                            card.className = 'generator-question-card';
                            card.dataset.index = idx;
                            card.style.border = '1px solid #ccc';
                            card.style.borderRadius = '4px';
                            card.style.padding = '1rem';
                            card.style.marginBottom = '0.75rem';
                            var prompt = document.createElement('p');
                            prompt.innerHTML = '<strong>Prompt:</strong> ' + escapeHtml(q.prompt || '');
                            card.appendChild(prompt);
                            var answers = Array.isArray(q.answers) ? q.answers : [];
                            if (answers.length) {
                                var ansTitle = document.createElement('p');
                                ansTitle.innerHTML = '<strong>Answers:</strong>';
                                card.appendChild(ansTitle);
                                var ansList = document.createElement('ul');
                                answers.forEach(function (ans) {
                                    var li = document.createElement('li');
                                    li.innerHTML = escapeHtml(ans);
                                    ansList.appendChild(li);
                                });
                                card.appendChild(ansList);
                            }
                            var correct = document.createElement('p');
                            correct.innerHTML = '<strong>Correct:</strong> ' + escapeHtml(q.correct_answer || '') + ' (index ' + (q.correct_index != null ? q.correct_index : 0) + ')';
                            card.appendChild(correct);
                            var actions = document.createElement('p');
                            actions.style.marginTop = '0.5rem';
                            var goodBtn = document.createElement('button');
                            goodBtn.type = 'button';
                            goodBtn.className = 'btn btn-small';
                            goodBtn.textContent = 'Good';
                            goodBtn.addEventListener('click', function () { saveQuestion(card, q, 'good'); });
                            var badBtn = document.createElement('button');
                            badBtn.type = 'button';
                            badBtn.className = 'btn btn-small btn-danger';
                            badBtn.textContent = 'Bad';
                            badBtn.style.marginLeft = '0.5rem';
                            badBtn.addEventListener('click', function () {
                                var existing = card.querySelector('textarea.bad-reason');
                                if (!existing) {
                                    var reasonLabel = document.createElement('label');
                                    reasonLabel.style.display = 'block';
                                    reasonLabel.style.marginTop = '0.5rem';
                                    reasonLabel.textContent = 'Why is this question bad?';
                                    var reasonBox = document.createElement('textarea');
                                    reasonBox.className = 'bad-reason';
                                    reasonBox.rows = 3;
                                    reasonBox.style.width = '100%';
                                    reasonBox.style.marginTop = '0.25rem';
                                    reasonBox.style.border = '1px solid #ccc';
                                    reasonBox.style.borderRadius = '4px';
                                    reasonBox.style.padding = '0.4rem';
                                    reasonLabel.appendChild(reasonBox);
                                    card.appendChild(reasonLabel);
                                    badBtn.textContent = 'Save as bad';
                                    reasonBox.focus();
                                    return;
                                }
                                var reasonText = existing.value || '';
                                saveQuestion(card, q, 'bad', reasonText);
                            });
                            actions.appendChild(goodBtn);
                            actions.appendChild(badBtn);
                            card.appendChild(actions);
                            questionsContainer.appendChild(card);
                        });
                    })
                    .catch(function (err) {
                        loadingEl.style.display = 'none';
                        showError(err.message || 'Generate failed.');
                    });
            });

            function saveQuestion(card, q, quality, badReason) {
                var body = {
                    prompt: q.prompt || '',
                    correctAnswer: q.correct_answer || '',
                    correctIndex: q.correct_index != null ? q.correct_index : 0,
                    answers: Array.isArray(q.answers) ? q.answers : [],
                    quality: quality
                };
                if (quality === 'bad' && typeof badReason === 'string') {
                    body.badReason = badReason;
                }
                fetch('/courses/' + courseId + '/tasks/' + selectedTaskId + '/questions', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(body),
                    credentials: 'same-origin'
                })
                    .then(function (r) {
                        if (!r.ok) return r.json().then(function (e) { throw new Error(e.error || 'Save failed'); });
                        card.style.opacity = '0.6';
                        var statusP = card.querySelector('p:last-of-type');
                        statusP.textContent = 'Saved as ' + quality + '.';
                        var buttons = card.querySelectorAll('button');
                        for (var i = 0; i < buttons.length; i++) buttons[i].disabled = true;
                        if (quality === 'good' && taskDetailsGoodCount) {
                            var n = parseInt(taskDetailsGoodCount.textContent, 10) || 0;
                            taskDetailsGoodCount.textContent = n + 1;
                        }
                    })
                    .catch(function (err) {
                        alert(err.message || 'Save failed.');
                    });
            }
        })();
    </script>
</div>
